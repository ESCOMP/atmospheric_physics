    real(kind_phys) :: rthratensw(ncol, pver)
    character(100) :: errmsg
    integer :: errflg

    cpairv(:, :) = 1004.0_kind_phys
    exner(:, :) = 0.9_kind_phys
    sw_heating_rate(:, :) = 1.8072_kind_phys
    rthratensw(:, :) = huge(0.0_kind_phys)

    call sw_heating_rate_to_air_potential_temperature_tendency_run( &
        cpairv, exner, sw_heating_rate, &
