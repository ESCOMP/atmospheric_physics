        errmsg, errflg)

    ! Should compute SW heating rate as potential temperature tendency correctly.
    @assertEqual(0.002_kind_phys, rthratensw, spacing(0.002_kind_phys))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)

    sw_heating_rate(:, :) = -1.8072_kind_phys
    rthratensw(:, :) = huge(0.0_kind_phys)

    call sw_heating_rate_to_air_potential_temperature_tendency_run( &
        cpairv, exner, sw_heating_rate, &
        rthratensw, &
        errmsg, errflg)

    ! Should compute SW heating rate as potential temperature tendency correctly.
    @assertEqual(-0.002_kind_phys, rthratensw, spacing(-0.002_kind_phys))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)
end subroutine test_sw_heating_rate_to_air_potential_temperature_tendency_run
