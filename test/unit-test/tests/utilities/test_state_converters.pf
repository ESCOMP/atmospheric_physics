@test
subroutine test_temp_to_potential_temp()
    use ccpp_kinds, only: kind_phys
    use funit
    use state_converters, only: temp_to_potential_temp_run, potential_temp_to_temp_run

    integer, parameter :: ncol = 100, pver = 10

    real(kind_phys) :: temp(ncol, pver), exner(ncol, pver), theta(ncol, pver)
    real(kind_phys) :: expected_temp(ncol, pver), expected_theta(ncol, pver)
    character(100) :: errmsg
    integer :: errflg

    integer :: k

    do k = 1, pver
        temp(:, k) = 200.0_kind_phys + real(k, kind_phys) * 10.0_kind_phys
        exner(:, k) = 0.5_kind_phys + real(k, kind_phys) * 0.05_kind_phys
    end do

    theta(:, :) = huge(0.0_kind_phys)

    expected_temp(:, :) = temp(:, :)
    expected_theta(:, :) = temp(:, :) / exner(:, :)

    call temp_to_potential_temp_run(ncol, pver, temp, exner, theta, errmsg, errflg)

    ! Should compute potential temperature correctly.
    @assertEqual(expected_theta, theta, maxval(spacing(expected_theta)))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)

    temp(:, :) = huge(0.0_kind_phys)

    call potential_temp_to_temp_run(ncol, pver, theta, exner, temp, errmsg, errflg)

    ! Should get back original temperature correctly.
    @assertEqual(expected_temp, temp, maxval(spacing(expected_temp)))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)
end subroutine test_temp_to_potential_temp

@test
subroutine test_temp_to_virtual_temp_run()
    use ccpp_kinds, only: kind_phys
    use funit
    use state_converters, only: temp_to_virtual_temp_run, virtual_temp_to_temp_run

    integer, parameter :: ncol = 100, pver = 10
    real(kind_phys), parameter :: rd = 287.04_kind_phys
    real(kind_phys), parameter :: rv = 461.52_kind_phys

    real(kind_phys) :: temp(ncol, pver), zvirv(ncol, pver), qv_dry(ncol, pver), qv_wet(ncol, pver), &
                       virtual_temp(ncol, pver)
    real(kind_phys) :: expected_temp(ncol, pver), expected_virtual_temp(ncol, pver)
    character(100) :: errmsg
    integer :: errflg

    temp(:, :) = 273.15_kind_phys
    zvirv(:, :) = rv / rd - 1.0_kind_phys
    qv_dry(:, :) = 0.02_kind_phys
    qv_wet(:, :) = qv_dry(:, :) / (1.0_kind_phys + qv_dry(:, :))
    virtual_temp(:, :) = huge(0.0_kind_phys)

    expected_temp(:, :) = temp(:, :)
    ! Use an alternative but equivalent formula for virtual temperature to verify the implementation here.
    expected_virtual_temp(:, :) = temp(:, :) * &
        (1.0_kind_phys + rv / rd * qv_dry(:, :)) / (1.0_kind_phys + qv_dry(:, :))

    call temp_to_virtual_temp_run(ncol, pver, temp, zvirv, qv_wet, virtual_temp, errmsg, errflg)

    ! Should compute virtual temperature correctly.
    @assertEqual(expected_virtual_temp, virtual_temp, maxval(spacing(expected_virtual_temp)))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)

    temp(:, :) = huge(0.0_kind_phys)

    call virtual_temp_to_temp_run(ncol, pver, virtual_temp, zvirv, qv_wet, temp, errmsg, errflg)

    ! Should get back original temperature correctly.
    @assertEqual(expected_temp, temp, maxval(spacing(expected_temp)))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)
end subroutine test_temp_to_virtual_temp_run

@test
subroutine test_calc_dry_air_ideal_gas_density_run()
    use ccpp_kinds, only: kind_phys
    use funit
    use state_converters, only: calc_dry_air_ideal_gas_density_run

    integer, parameter :: ncol = 100, pver = 10
    real(kind_phys), parameter :: rd = 287.04_kind_phys

    real(kind_phys) :: rairv(ncol, pver), pmiddry(ncol, pver), temp(ncol, pver), rho(ncol, pver)
    real(kind_phys) :: expected_rho(ncol, pver)
    character(100) :: errmsg
    integer :: errflg

    integer :: k

    rairv(:, :) = rd

    do k = 1, pver
        pmiddry(:, k) = real(k, kind_phys) * 10000.0_kind_phys
        temp(:, k) = 200.0_kind_phys + real(k, kind_phys) * 10.0_kind_phys
    end do

    rho(:, :) = huge(0.0_kind_phys)

    expected_rho(:, :) = pmiddry(:, :) / (rd * temp(:, :))

    call calc_dry_air_ideal_gas_density_run(ncol, pver, rairv, pmiddry, temp, rho, errmsg, errflg)

    ! Should compute dry air density correctly.
    @assertEqual(expected_rho, rho, maxval(spacing(expected_rho)))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)
end subroutine test_calc_dry_air_ideal_gas_density_run

@test
subroutine test_calc_air_ideal_gas_density_run()
    use ccpp_kinds, only: kind_phys
    use funit
    use state_converters, only: calc_air_ideal_gas_density_run

    integer, parameter :: ncol = 100, pver = 10
    real(kind_phys), parameter :: rd = 287.04_kind_phys

    real(kind_phys) :: rairv(ncol, pver), pmid(ncol, pver), virtual_temp(ncol, pver), rho(ncol, pver)
    real(kind_phys) :: expected_rho(ncol, pver)
    character(100) :: errmsg
    integer :: errflg

    rairv(:, :) = rd
    pmid(:, :) = 101325.0_kind_phys
    virtual_temp(:, :) = 273.15_kind_phys
    rho(:, :) = huge(0.0_kind_phys)

    expected_rho(:, :) = pmid(:, :) / (rd * virtual_temp(:, :))

    call calc_air_ideal_gas_density_run(ncol, pver, rairv, pmid, virtual_temp, rho, errmsg, errflg)

    ! Should compute air density correctly.
    @assertEqual(expected_rho, rho, maxval(spacing(expected_rho)))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)
end subroutine test_calc_air_ideal_gas_density_run

@test
subroutine test_calc_atmosphere_layer_thickness_run()
    use ccpp_kinds, only: kind_phys
    use funit
    use state_converters, only: calc_atmosphere_layer_thickness_run

    integer, parameter :: ncol = 100, pver = 10, pverp = 11
    real(kind_phys) :: zisfc(ncol, pverp)
    real(kind_phys) :: dz(ncol, pver)
    character(100) :: errmsg
    integer :: errflg

    integer :: i

    do i = 1, pverp
        zisfc(:, i) = 10000.0_kind_phys - real(i - 1, kind_phys) * 1000.0_kind_phys
    end do

    dz(:, :) = huge(0.0_kind_phys)

    call calc_atmosphere_layer_thickness_run( &
        ncol, &
        zisfc, &
        dz, &
        errmsg, errflg)

    ! Should compute atmosphere layer thickness correctly.
    @assertEqual(1000.0_kind_phys, dz, spacing(1000.0_kind_phys))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)
end subroutine test_calc_atmosphere_layer_thickness_run

@test
subroutine test_calc_exner_run()
    use ccpp_kinds, only: kind_phys
    use funit
    use state_converters, only: calc_exner_run

    integer, parameter :: ncol = 100, pver = 10
    real(kind_phys), parameter :: cpd = 1004.64_kind_phys
    real(kind_phys), parameter :: pref = 100000.0_kind_phys
    real(kind_phys), parameter :: rd = 287.04_kind_phys

    real(kind_phys) :: cpairv(ncol, pver), rairv(ncol, pver), pmid(ncol, pver), exner(ncol, pver)
    real(kind_phys) :: expected_exner(ncol, pver)
    character(100) :: errmsg
    integer :: errflg

    integer :: k

    cpairv(:, :) = cpd
    rairv(:, :) = rd

    do k = 1, pver
        pmid(:, k) = real(k, kind_phys) * 10000.0_kind_phys
    end do

    exner(:, :) = huge(0.0_kind_phys)

    expected_exner(:, :) = (pmid(:, :) / pref) ** (rairv(:, :) / cpairv(:, :))

    call calc_exner_run(ncol, pver, cpairv, rairv, pref, pmid, exner, errmsg, errflg)

    ! Should compute Exner function correctly.
    @assertEqual(1.0_kind_phys, exner(:, pver), spacing(1.0_kind_phys))
    @assertEqual(expected_exner, exner, maxval(spacing(expected_exner)))
    @assertEqual('', errmsg)
    @assertEqual(0, errflg)
end subroutine test_calc_exner_run
