[ccpp-table-properties]
  name = ozone_constituent_stub
  type = scheme
  dependencies = ../../to_be_ccppized/ccpp_chem_utils.F90
[ccpp-arg-table]
  name = ozone_constituent_stub_register
  type = scheme
[ constituents ]
  standard_name = dynamic_constituents_for_ozone_constituent_stub
  units = none
  dimensions = (:)
  allocatable = True
  type = ccpp_constituent_properties_t
  intent = out
[ errmsg ]
