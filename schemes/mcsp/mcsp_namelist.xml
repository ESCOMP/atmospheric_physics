<?xml version="1.0"?>

<?xml-stylesheet type="text/xsl" href="namelist_definition.xsl"?>

<entry_id_pg version="2.0">

<!-- Mesoscale coherent structure parameterization (MCSP).
     The scheme is inactive while all four coefficients are zero. -->

<entry id="mcsp_heat_coeff">
  <category>conv</category>
  <group>mcsp_nl</group>
  <standard_name>tunable_heating_coefficient_for_mesoscale_coherent_structure_parameterization</standard_name>
  <units>1</units>
  <type>real</type>
  <kind>kind_phys</kind>
  <desc>
    Coefficient scaling the MCSP temperature tendency, which redistributes the deep
    convective heating vertically. Zero turns the temperature tendency off.
  </desc>
  <values>
     <value>0.0D0</value>
  </values>
</entry>

<entry id="mcsp_moisture_coeff">
  <category>conv</category>
  <group>mcsp_nl</group>
  <standard_name>tunable_moistening_coefficient_for_mesoscale_coherent_structure_parameterization</standard_name>
  <units>1</units>
  <type>real</type>
  <kind>kind_phys</kind>
  <desc>
    Coefficient scaling the MCSP water vapor tendency, which redistributes the deep
    convective moistening vertically. Zero turns the water vapor tendency off.
  </desc>
  <values>
     <value>0.0D0</value>
  </values>
</entry>

<entry id="mcsp_uwind_coeff">
  <category>conv</category>
  <group>mcsp_nl</group>
  <standard_name>tunable_eastward_wind_coefficient_for_mesoscale_coherent_structure_parameterization</standard_name>
  <units>m s-2</units>
  <type>real</type>
  <kind>kind_phys</kind>
  <desc>
    Coefficient scaling the MCSP eastward wind tendency. Zero turns it off.
  </desc>
  <values>
     <value>0.0D0</value>
  </values>
</entry>

<entry id="mcsp_vwind_coeff">
  <category>conv</category>
  <group>mcsp_nl</group>
  <standard_name>tunable_northward_wind_coefficient_for_mesoscale_coherent_structure_parameterization</standard_name>
  <units>m s-2</units>
  <type>real</type>
  <kind>kind_phys</kind>
  <desc>
    Coefficient scaling the MCSP northward wind tendency. Zero turns it off.
  </desc>
  <values>
     <value>0.0D0</value>
  </values>
</entry>

<entry id="mcsp_storm_speed_pref">
  <category>conv</category>
  <group>mcsp_nl</group>
  <standard_name>reference_air_pressure_for_storm_level_wind_for_mesoscale_coherent_structure_parameterization</standard_name>
  <units>Pa</units>
  <type>real</type>
  <kind>kind_phys</kind>
  <desc>
    Reference pressure level of the storm-level eastward wind used in the MCSP
    low-level shear calculation.
  </desc>
  <values>
     <value>60000.0D0</value>
  </values>
</entry>

<entry id="mcsp_conv_depth_min">
  <category>conv</category>
  <group>mcsp_nl</group>
  <standard_name>minimum_pressure_depth_of_deep_convection_for_mesoscale_coherent_structure_parameterization</standard_name>
  <units>Pa</units>
  <type>real</type>
  <kind>kind_phys</kind>
  <desc>
    Minimum pressure depth of deep convection for MCSP to be active in a column.
  </desc>
  <values>
     <value>50000.0D0</value>
  </values>
</entry>

<entry id="mcsp_shear_min">
  <category>conv</category>
  <group>mcsp_nl</group>
  <standard_name>minimum_low_level_eastward_wind_shear_for_mesoscale_coherent_structure_parameterization</standard_name>
  <units>m s-1</units>
  <type>real</type>
  <kind>kind_phys</kind>
  <desc>
    Minimum magnitude of the eastward wind shear between the mcsp_storm_speed_pref
    level and the lowest model layer for MCSP to be active in a column.
  </desc>
  <values>
     <value>3.0D0</value>
  </values>
</entry>

</entry_id_pg>
