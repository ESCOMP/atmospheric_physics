[ccpp-table-properties]
  name = rk_stratiform_pumas_optics_inputs
  type = scheme

[ccpp-arg-table]
  name  = rk_stratiform_pumas_optics_inputs_run
  type  = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ rel ]
  standard_name = effective_radius_of_stratiform_cloud_liquid_water_droplet
  units = um
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ rei ]
  standard_name = effective_radius_of_stratiform_cloud_ice_crystal
  units = um
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ iclwp ]
  standard_name = in_cloud_liquid_water_path_for_radiation
  units = kg m-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ iciwp ]
  standard_name = in_cloud_ice_water_path
  units = kg m-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dei ]
  standard_name = effective_diameter_of_stratiform_cloud_ice_crystal_for_radiation
  units = um
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ pgam ]
  standard_name = size_distribution_shape_parameter_for_microphysics
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ lamc ]
  standard_name = slope_of_droplet_distribution_for_optics
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
