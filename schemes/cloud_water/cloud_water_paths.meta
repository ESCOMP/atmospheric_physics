[ccpp-table-properties]
  name = cloud_water_paths
  type = scheme

[ccpp-arg-table]
  name  = cloud_water_paths_run
  type  = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ top_lev ]
  standard_name = vertical_layer_index_of_troposphere_cloud_physics_top
  units = index
  type = integer
  dimensions = ()
  intent = in
[ conv_water_in_rad ]
  standard_name = control_for_convective_water_in_radiation
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rair ]
  standard_name = gas_constant_of_dry_air
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ ls_liq ]
  standard_name = cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
  advected = true
[ ls_ice ]
  standard_name = cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
  advected = true
[ cld ]
  standard_name = cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ concld ]
  standard_name = convective_cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ totg_liq ]
  standard_name = gridbox_total_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ totg_ice ]
  standard_name = gridbox_total_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ qsout ]
  standard_name = snow_mixing_ratio_wrt_moist_air_and_condensed_water_of_new_state
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ qgout ]
  standard_name = graupel_water_mixing_ratio_wrt_moist_air_and_condensed_water_of_new_state
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ iclwp ]
  standard_name = in_cloud_liquid_water_path_for_radiation
  units = kg m-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ iciwp ]
  standard_name = in_cloud_ice_water_path
  units = kg m-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cldfsnow ]
  standard_name = liquid_plus_snow_stratiform_cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ icswp ]
  standard_name = in_cloud_snow_water_path
  units = kg m-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ cldfgrau ]
  standard_name = liquid_plus_graupel_stratiform_cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ icgrauwp ]
  standard_name = stratiform_in_cloud_graupel_water_path
  units = kg m-2
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ icimr ]
  standard_name = in_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ icwmr ]
  standard_name = in_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ iwc ]
  standard_name = gridbox_mean_ice_water_content
  units = kg m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ lwc ]
  standard_name = gridbox_mean_liquid_water_content
  units = kg m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
