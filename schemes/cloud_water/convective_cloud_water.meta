[ccpp-table-properties]
  name = convective_cloud_water
  type = scheme

[ccpp-arg-table]
  name  = convective_cloud_water_run
  type  = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ conv_water_in_rad ]
  standard_name = control_for_convective_water_in_radiation
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ frac_limit ]
  standard_name = minimum_cloud_fraction_for_convective_water_in_radiation
  units = fraction
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ one_mom_clouds ]
  standard_name = flag_for_one_moment_cloud_microphysics
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ ls_liq ]
  standard_name = cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
  advected = true
[ ls_ice ]
  standard_name = cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
  advected = true
[ sh_icwmr ]
  standard_name = in_cloud_water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_shallow_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dp_icwmr ]
  standard_name = in_cloud_water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_deep_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ sh_frac ]
  standard_name = shallow_convective_cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dp_frac ]
  standard_name = deep_convective_cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ ast ]
  standard_name = stratiform_cloud_area_fraction
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ rei ]
  standard_name = effective_radius_of_stratiform_cloud_ice_particle
  units = um
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ totg_liq ]
  standard_name = gridbox_total_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ totg_ice ]
  standard_name = gridbox_total_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ conv_liq ]
  standard_name = in_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_all_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ conv_ice ]
  standard_name = in_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_all_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ tot_liq ]
  standard_name = total_in_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ tot_ice ]
  standard_name = total_in_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ totg_liq_sh ]
  standard_name = gridbox_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_shallow_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ totg_liq_dp ]
  standard_name = gridbox_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_deep_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ totg_ice_sh ]
  standard_name = gridbox_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_shallow_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ totg_ice_dp ]
  standard_name = gridbox_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_deep_convection
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ fresh ]
  standard_name = frequency_of_occurrence_of_shallow_convection_with_condensate
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ fredp ]
  standard_name = frequency_of_occurrence_of_deep_convection_with_condensate
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ frecu ]
  standard_name = frequency_of_occurrence_of_convection_with_condensate
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ fretot ]
  standard_name = frequency_of_occurrence_of_cloud_with_condensate
  units = 1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
