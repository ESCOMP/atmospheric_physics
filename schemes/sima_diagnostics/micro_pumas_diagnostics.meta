  standard_name = analytic_radar_reflectivity_z_factor_at_94_GHz
  units = mm6 m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ frefl ]
  standard_name = fraction_of_gridcell_with_nonzero_radar_reflectivity
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ csrfl ]
  standard_name = analytic_radar_reflectivity_at_94_GHz_with_cloudsat_thresholds_in_precipitating_fraction_of_gridcell
  units = dBZ
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ acsrfl ]
  standard_name = analytic_radar_reflectivity_at_94_GHz_with_cloudsat_thresholds
  units = dBZ
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ fcsrfl ]
  standard_name = fraction_of_gridcell_with_nonzero_radar_reflectivity_with_cloudsat_thresholds
  units = fraction
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ refl10cm ]
  standard_name = analytic_radar_reflectivity_at_10_cm_wavelength
  units = dBZ
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ reflz10cm ]
  standard_name = analytic_radar_reflectivity_z_factor_at_10_cm_wavelength
  units = mm6 m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ rercld ]
  standard_name = effective_radius_of_stratiform_cloud_liquid_plus_rain_drops
  # FOR_REVIEWER_FEEDBACK: the values are in meters (calc_rercld in micro_pumas_v1.F90), but
  #    micro_pumas_ccpp.meta and micro_pumas_ccpp_dimensions_post.meta declare 'um'.  The units
  #    here match so that the CCPP framework does not apply a unit conversion.  Should the
  #    units be fixed to 'm' in the PUMAS and dimensions_post metadata (and then here)?
  units = um
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ ncai ]
  standard_name = available_ice_nuclei_number_concentration_of_new_state
  units = m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ ncal ]
  standard_name = available_cloud_condensation_nuclei_number_concentration_of_new_state
  units = m-3
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ qrout2 ]
  standard_name = rain_mixing_ratio_wrt_moist_air_and_condensed_water_of_new_state
  units = kg kg-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
