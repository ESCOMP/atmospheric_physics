  standard_name = analytic_radar_reflectivity_at_94_GHz_in_precipitating_fraction_of_gridcell
  units = dBZ
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
