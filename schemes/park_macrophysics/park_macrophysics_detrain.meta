[ccpp-table-properties]
  name = park_macrophysics_detrain
  type = scheme

#########################################################
[ccpp-arg-table]
  name  = park_macrophysics_detrain_run
  type  = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ top_lev ]
  standard_name = vertical_layer_index_of_cloud_fraction_top
  units = index
  type = integer
  dimensions = ()
  intent = in
[ latice ]
  standard_name = latent_heat_of_fusion_of_water_at_0c
  units = J kg-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ cpair ]
  standard_name = specific_heat_of_dry_air_at_constant_pressure
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ do_detrain ]
  standard_name = do_convective_condensate_detrainment_for_park_macrophysics_tbd
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dlf ]
  standard_name = detrainment_of_cloud_liquid_water_wrt_moist_air_and_condensed_water_due_to_all_convection
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dlf2 ]
  standard_name = detrainment_of_cloud_liquid_water_wrt_moist_air_and_condensed_water_due_to_shallow_convection
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ tend_cldliq ]
  standard_name = tendency_of_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
  constituent = true
[ tend_cldice ]
  standard_name = tendency_of_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
  constituent = true
[ tend_numliq ]
  # NOT applied to the prognostic as a constituent tendency: this detrainment number
  # tendency is delivered to park_macrophysics_run, which sums it with the macrophysics
  # tendency into a single update to avoid catastrophic cancellation at cloud edges.
  standard_name = tendency_of_mass_number_concentration_of_cloud_liquid_wrt_moist_air_and_condensed_water_due_to_park_macrophysics_detrainment
  units = kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ tend_numice ]
  standard_name = tendency_of_mass_number_concentration_of_cloud_ice_water_crystals_in_moist_air_and_condensed_water
  units = kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
  constituent = true
[ tend_s ]
  standard_name = tendency_of_dry_air_enthalpy_at_constant_pressure
  units = J kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ det_s ]
  standard_name = vertically_integrated_heating_from_freezing_of_detrained_liquid_due_to_all_convection
  units = J m-2 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = out
[ det_ice ]
  standard_name = vertically_integrated_detrainment_of_ice_due_to_all_convection
  units = m s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent)
  intent = out
[ dpdlfliq ]
  standard_name = deep_convective_detrainment_of_cloud_liquid_water_wrt_moist_air_and_condensed_water_tbd
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dpdlfice ]
  standard_name = deep_convective_detrainment_of_cloud_ice_wrt_moist_air_and_condensed_water_tbd
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ shdlfliq ]
  standard_name = shallow_convective_detrainment_of_cloud_liquid_water_wrt_moist_air_and_condensed_water_tbd
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ shdlfice ]
  standard_name = shallow_convective_detrainment_of_cloud_ice_wrt_moist_air_and_condensed_water_tbd
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dpdlft ]
  standard_name = tendency_of_air_temperature_due_to_deep_convective_detrainment_tbd
  units = K s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ shdlft ]
  standard_name = tendency_of_air_temperature_due_to_shallow_convective_detrainment_tbd
  units = K s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dlf_T ]
  standard_name = tendency_of_air_temperature_due_to_convective_detrainment_to_stratiform_cloud_tbd
  units = K s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dlf_qv ]
  standard_name = tendency_of_water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_convective_detrainment_to_stratiform_cloud_tbd
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dlf_ql ]
  standard_name = tendency_of_cloud_liquid_water_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_convective_detrainment_to_stratiform_cloud_tbd
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dlf_qi ]
  standard_name = tendency_of_cloud_ice_mixing_ratio_wrt_moist_air_and_condensed_water_due_to_convective_detrainment_to_stratiform_cloud_tbd
  units = kg kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dlf_nl ]
  standard_name = tendency_of_mass_number_concentration_of_cloud_liquid_wrt_moist_air_and_condensed_water_due_to_convective_detrainment_to_stratiform_cloud_tbd
  units = kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ dlf_ni ]
  standard_name = tendency_of_mass_number_concentration_of_ice_wrt_moist_air_and_condensed_water_due_to_convective_detrainment_to_stratiform_cloud_tbd
  units = kg-1 s-1
  type = real | kind = kind_phys
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ scheme_name ]
  standard_name = scheme_name
  units = none
  type = character | kind = len=64
  dimensions = ()
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
