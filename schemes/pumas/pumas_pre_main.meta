[ccpp-table-properties]
  name = pumas_pre_main
  type = scheme
  dependencies = pumas/pumas_kinds.F90,pumas/pumas_gamma_function.F90,pumas/micro_pumas_utils.F90
  dependencies = pumas/pumas_stochastic_collect_tau.F90

[ccpp-arg-table]
  name = pumas_pre_main_init
  type = scheme
[ do_clubb_sgs ]
  standard_name = do_clubb
  long_name = Flag indicating whether CLUBB is being used in the suite or not
  units = flag
  type = logical
  dimensions = ()
  intent = in
[spat_vary_accre_enhan_in]
  standard_name = accretion_enhancement_factor
  long_name = accretion enhancement factor
  units = 1
  dimensions = (horizontal_dimension, vertical_layer_dimension)
  type = real
  kind = kind_phys
  intent = out
[remove_supersat]
  standard_name = remove_supersaturation_after_sedimentation
  long_name = remove supersaturation after sedimentation
  units = flag
  dimensions = ()
  type = logical
  intent = out
[ micro_mg_warm_rain ]
  standard_name = control_for_warm_rain_method
  long_name = warm rain method (KK2000,sb2001,tau,emulated)
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ pumas_stochastic_tau_kernel_filename ]
  standard_name = filename_of_stochastic_collection_kernel_for_tau
  long_name = filename of the collection kernel for the TAU stochastic collection code
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  long_name = Error message for error handling in CCPP
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errcode ]
  standard_name = ccpp_error_code
  long_name = Error flag for error handling in CCPP
  units = 1
  type = integer
  dimensions = ()
  intent = out

#####################
#End of metadata file
#####################
