[ccpp-table-properties]
  name = prescribe_lower_boundary_conditions
  type = scheme

[ccpp-arg-table]
  name  = prescribe_lower_boundary_conditions_init
  type  = scheme
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ pi ]
  standard_name = pi_constant
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ lat ]
  standard_name = latitude
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_dimension)
  intent = in
[ lon ]
  standard_name = longitude
  units = rad
  type = real | kind = kind_phys
  dimensions = (horizontal_dimension)
  intent = in
[ curr_date ]
  standard_name = current_model_date_in_iso_order
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ curr_sec ]
  standard_name = seconds_of_current_model_date
  units = s
  type = integer
  dimensions = ()
  intent = in
[ flbc_file ]
  standard_name = filename_of_lower_boundary_conditions
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ flbc_list ]
  standard_name = list_of_species_for_lower_boundary_conditions
  units = none
  type = character | kind = len=*
  dimensions = (flbc_list_dimension)
  intent = in
[ flbc_type ]
  standard_name = time_interpolation_method_for_lower_boundary_conditions
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ flbc_cycle_yr ]
  standard_name = cycle_year_for_lower_boundary_conditions
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ flbc_fixed_ymd ]
  standard_name = fixed_date_for_lower_boundary_conditions
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ flbc_fixed_tod ]
  standard_name = fixed_time_of_day_for_lower_boundary_conditions
  units = s
  type = integer
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

