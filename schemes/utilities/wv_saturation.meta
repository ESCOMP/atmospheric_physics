[ccpp-table-properties]
  name = wv_saturation
  type = scheme
  dependencies = ../../to_be_ccppized/wv_sat_methods.F90

[ccpp-arg-table]
  name  = wv_saturation_init
  type  = scheme
[ wv_sat_scheme ]
  standard_name = control_for_saturation_vapor_pressure_method
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ tmelt_in ]
  standard_name = freezing_point_of_water
  units = K
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ h2otrip_in ]
  standard_name = triple_point_temperature_of_water
  units = K
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ epsilo_in ]
  standard_name = ratio_of_water_vapor_to_dry_air_molecular_weights
  units = 1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ latvap_in ]
  standard_name = latent_heat_of_vaporization_of_water_at_0c
  units = J kg-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ latice_in ]
  standard_name = latent_heat_of_fusion_of_water_at_0c
  units = J kg-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ rh2o_in ]
  standard_name = gas_constant_of_water_vapor
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ cpair_in ]
  standard_name = specific_heat_of_dry_air_at_constant_pressure
  units = J kg-1 K-1
  type = real | kind = kind_phys
  dimensions = ()
  intent = in
[ amIRoot ]
  standard_name = flag_for_mpi_root
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iulog ]
  standard_name = log_output_unit
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

[ccpp-arg-table]
  name  = wv_saturation_final
  type  = scheme
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
